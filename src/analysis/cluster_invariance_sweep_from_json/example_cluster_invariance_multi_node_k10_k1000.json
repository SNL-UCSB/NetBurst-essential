{
  "sweep_job_name": "clust_inv_multi_k10_k1000",
  "submission_style": "multi_node_single_job",
  "runner": "slurm",
  "environment": "nersc",
  "k_values": [
    10,
    1000
  ],
  "run_values": [
    1
  ],
  "job_name_template": "<USER_Input>",
  "clustering_labels_template": "<USER_Input>",
  "tsfresh_csv": "<USER_Input>",
  "out_csv_template": "<USER_Input>",
